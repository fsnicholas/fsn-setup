# # ex = EXtractor for all kinds of archives
# # usage: ex <file>
ex ()
{
  if [ -f $1 ] ; then
    case $1 in
      *.tar.bz2)   tar xjf $1   ;;
      *.tar.gz)    tar xzf $1   ;;
      *.bz2)       bunzip2 $1   ;;
      *.rar)       unrar x $1   ;;
      *.gz)        gunzip $1    ;;
      *.tar)       tar xf $1    ;;
      *.tbz2)      tar xjf $1   ;;
      *.tgz)       tar xzf $1   ;;
      *.zip)       unzip $1     ;;
      *.Z)         uncompress $1;;
      *.7z)        7z x $1      ;;
      *.deb)       ar x $1      ;;
      *.tar.xz)    tar xf $1    ;;
      *.tar.zst)   tar $1       ;;
      *)           echo "'$1' cannot be extracted via ex()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Function to show aliases by group
show-als() {
    local filter="${1:-.*}"
    alias | grep -i "$filter" | sort | cat
}


## usage help command e.g. helpb cp
alias bathelp='bat --plain --language=help'
helpb ()
{
    "$@" --help 2>&1 | bathelp
}


alf() {
    alias | grep -i "$1" | sed "s/^alias //; s/='/ = /; s/'$//" | sort | \
    awk '{printf "%-15s %-1s %s\n", $1, $2, substr($0, index($0,$3))}'
}

# uv update the global tools
